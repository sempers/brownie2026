<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up / transfer only the user's sound settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="BrowniePrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="BrowniePrefs.xml" />
    </device-transfer>
</data-extraction-rules>
